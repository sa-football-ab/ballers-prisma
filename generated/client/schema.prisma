// prisma/schema.prisma

generator client {
    provider      = "prisma-client-js"
    output        = "./generated/client"
    binaryTargets = ["native", "linux-arm64-openssl-1.1.x"]
}

// ---------------------------- Auth Service ------------------------------------- //

// User Type Enum defination
enum UserType {
    PLAYER
    COACH
    ADMIN
}

enum VisibilityType {
    RESTRICTED
    RECOMMENDED
}

enum AdminRole {
    GENERAL
    BALLERS
    LOK
}

enum Language {
    EN
    SV
    ES
}

// User model
model User {
    id             String     @id
    userType       UserType   @default(PLAYER)
    club           Club       @relation(fields: [clubId], references: [id])
    clubId         String
    team           Team?      @relation(fields: [teamId], references: [id])
    teamId         String?
    disability     Boolean    @default(false)
    personNumber   String?
    email          String?
    firstName      String?
    lastName       String?
    clubOnboarding Boolean    @default(true)
    gender         String?
    Activity       Activity[]
    createdBy      AdminRole  @default(LOK) // This tracks who created the user
    dateCreated    DateTime   @default(now())
    dateUpdated    DateTime?

    @@index([clubId])
    @@index([teamId])
}

// Club Table defination
model Club {
    id                 String             @id
    display            String
    location           String?
    income             Int                @default(0)
    organizationNumber String?
    dateCreated        DateTime           @default(now())
    dateUpdated        DateTime?
    type               AdminRole          @default(LOK)
    subscriptionStatus SubscriptionStatus @default(FREE)
    teams              Team[]
    Activity           Activity[]
    User               User[]
}

// Team model
model Team {
    id          String     @id
    display     String
    club        Club       @relation(fields: [clubId], references: [id])
    clubId      String
    voided      Boolean    @default(false) // Default value false
    dateCreated DateTime   @default(now())
    dateUpdated DateTime?
    Activity    Activity[]
    User        User[]
}

model Activity {
    id             String         @id
    team           Team?          @relation(fields: [teamId], references: [id])
    teamId         String?
    club           Club           @relation(fields: [clubId], references: [id])
    clubId         String
    user           User           @relation(fields: [coachUserId], references: [id])
    coachUserId    String
    description    String
    noOfReg        Int
    activityDate   DateTime
    income         Int            @default(0)
    program        String
    minAge         Int
    maxAge         Int
    visibilityType VisibilityType @default(RECOMMENDED)
    equipments     Json
    type           AdminRole      @default(LOK)
    language       Language       @default(EN)
    dateCreated    DateTime       @default(now())
    dateUpdated    DateTime?

    @@index([coachUserId])
    @@index([clubId])
}

// ---------------------------- Training Program Service ------------------------------------- //
// PlayerTraining Table defination
model PlayerTraining {
    id                           String    @id
    userId                       String
    //Keys of the player training program
    playerTrainingProgramId      String
    playerTrainingProgramLevelId String
    playerTrainingProgramWeekId  String
    //Actual keys of the training program
    trainingIndex                Int       @default(-1)
    points                       Int
    isCompleted                  Boolean
    dateCompleted                DateTime?
    dateCreated                  DateTime  @default(now())
    trainingStartTime            DateTime?
    trainingEndTime              DateTime?
    address                      String?
}

// PlayerTrainingWeek Table defination
model PlayerTrainingWeek {
    id                           String    @id
    userId                       String
    //Keys of the player training program
    playerTrainingProgramId      String
    playerTrainingProgramLevelId String
    //Actual keys of the training program
    trainingProgramWeekIndex     Int       @default(-1)
    isCompleted                  Boolean
    dateCompleted                DateTime?
    dateCreated                  DateTime  @default(now())

    @@index([playerTrainingProgramLevelId])
    @@index([playerTrainingProgramLevelId, isCompleted])
}

// PlayerTrainingLevel Table defination
model PlayerTrainingLevel {
    id                        String    @id
    userId                    String
    //Keys of the player training program
    playerTrainingProgramId   String
    //Actual keys of the training program
    trainingProgramLevelIndex Int       @default(-1)
    isCompleted               Boolean
    dateCompleted             DateTime?
    dateCreated               DateTime  @default(now())

    @@index([playerTrainingProgramId])
    @@index([trainingProgramLevelIndex])
    @@index([playerTrainingProgramId, trainingProgramLevelIndex, userId])
}

// Subscription Status Enum defination
enum SubscriptionStatus {
    FREE
    PREMIUM
}

// Subscription Type Enum defination
enum SubscriptionType {
    RECURRING
    ONE_OFF
    FREE
    PREMIUM
    CLUB
    AI
    ACTIVITY
}

// PlayerTrainingProgram Table defination
model PlayerTrainingProgram {
    id                String           @id
    userId            String
    trainingProgramId String
    isCompleted       Boolean
    isLocked          Boolean
    isLiked           Boolean          @default(false)
    isPremium         Boolean
    subscriptionType  SubscriptionType
    subscriptionId    String?
    dateCompleted     DateTime?
    dateCreated       DateTime         @default(now())

    @@index([userId])
    @@index([trainingProgramId])
    @@index([userId, isLocked])
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}
