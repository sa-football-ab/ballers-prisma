generator client {
    provider      = "prisma-client-js"
    output        = "./generated/client"
    binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "mysql"
}

// ---------------------------- Existing Enums ------------------------------------- //

enum UserType {
    PLAYER
    COACH
    ADMIN
    ANALYST
}

enum VisibilityType {
    RESTRICTED
    RECOMMENDED
}

enum AdminRole {
    GENERAL
    BALLERS
    LOK
}

enum Language {
    EN
    SV
    ES
}

enum SubscriptionStatus {
    FREE
    PREMIUM
}

enum SubscriptionType {
    RECURRING
    ONE_OFF
    FREE
    PREMIUM
    CLUB
    AI
    ACTIVITY
}

// ---------------------------- New Enums For Admin Dashboard ------------------------------------- //

enum ChurnStatus {
    HEALTHY
    MIGHT_LEAVE_SOON
    AT_RISK
    CHURNED
}

enum SubscriptionTiers {
    ADMIN
    STRIPE
}

enum BookingStatus {
    BOOKED
    NO_BOOKING
}

enum AttendanceStatus {
    ATTENDED
    NO_SHOW
}

// ---------------------------- Existing Models (Extended Where Needed) ------------------------------------- //

model User {
    id             String            @id
    userType       UserType          @default(PLAYER)
    club           Club?             @relation(fields: [clubId], references: [id])
    clubId         String?
    team           Team?             @relation(fields: [teamId], references: [id])
    teamId         String?
    disability     Boolean           @default(false)
    personNumber   String?
    email          String?           @unique
    firstName      String?
    lastName       String?
    clubOnboarding Boolean           @default(false)
    gender         String?
    createdBy      AdminRole         @default(LOK)
    dateCreated    DateTime          @default(now())
    dateUpdated    DateTime?
    subscription   SubscriptionTiers @default(ADMIN)
    joinedAt       DateTime          @default(now())
    lastActivityAt DateTime?

    Activity        Activity[]
    sessionBookings SessionBooking[]     @relation("SessionBookingPlayer")
    churnEvents     ChurnEvent[]
    healthSummary   PlayerHealthSummary?

    @@index([clubId])
    @@index([teamId])
    @@index([joinedAt])
    @@index([lastActivityAt])
}

model Club {
    id                 String             @id
    display            String
    location           String?
    income             Int                @default(0)
    organizationNumber String?
    dateCreated        DateTime           @default(now())
    dateUpdated        DateTime?
    type               AdminRole          @default(LOK)
    subscriptionStatus SubscriptionStatus @default(FREE)

    teams    Team[]
    Activity Activity[]
    User     User[]
    metrics  MonthlyChurnMetric[]
}

model Team {
    id          String    @id
    display     String
    club        Club      @relation(fields: [clubId], references: [id])
    clubId      String
    voided      Boolean   @default(false)
    dateCreated DateTime  @default(now())
    dateUpdated DateTime?

    Activity Activity[]
    User     User[]
}

model Activity {
    id             String         @id
    team           Team?          @relation(fields: [teamId], references: [id])
    teamId         String?
    club           Club?          @relation(fields: [clubId], references: [id])
    clubId         String?
    user           User           @relation(fields: [coachUserId], references: [id])
    name           String         @default("Ballers")
    coachUserId    String
    description    String         @db.Text
    noOfReg        Int
    activityDate   DateTime
    income         Int            @default(0)
    program        String
    minAge         Int
    maxAge         Int
    visibilityType VisibilityType @default(RECOMMENDED)
    equipments     Json
    type           AdminRole      @default(LOK)
    language       Language       @default(EN)
    dateCreated    DateTime       @default(now())
    dateUpdated    DateTime?

    bookings SessionBooking[]

    @@index([coachUserId])
    @@index([clubId])
    @@index([activityDate])
}

model PlayerTraining {
    id                           String    @id
    userId                       String
    playerTrainingProgramId      String
    playerTrainingProgramLevelId String
    playerTrainingProgramWeekId  String
    trainingIndex                Int       @default(-1)
    points                       Int
    isCompleted                  Boolean
    dateCompleted                DateTime?
    dateCreated                  DateTime  @default(now())
    trainingStartTime            DateTime?
    trainingEndTime              DateTime?
    address                      String?
}

model PlayerTrainingWeek {
    id                           String    @id
    userId                       String
    playerTrainingProgramId      String
    playerTrainingProgramLevelId String
    trainingProgramWeekIndex     Int       @default(-1)
    isCompleted                  Boolean
    dateCompleted                DateTime?
    dateCreated                  DateTime  @default(now())

    @@index([playerTrainingProgramLevelId])
    @@index([playerTrainingProgramLevelId, isCompleted])
}

model PlayerTrainingLevel {
    id                        String    @id
    userId                    String
    playerTrainingProgramId   String
    trainingProgramLevelIndex Int       @default(-1)
    isCompleted               Boolean
    dateCompleted             DateTime?
    dateCreated               DateTime  @default(now())

    @@index([playerTrainingProgramId])
    @@index([trainingProgramLevelIndex])
    @@index([playerTrainingProgramId, trainingProgramLevelIndex, userId])
}

model PlayerTrainingProgram {
    id                String           @id
    userId            String
    trainingProgramId String
    isCompleted       Boolean
    isLocked          Boolean
    isLiked           Boolean          @default(false)
    isPremium         Boolean
    subscriptionType  SubscriptionType
    subscriptionId    String?
    dateCompleted     DateTime?
    dateCreated       DateTime         @default(now())

    @@index([userId])
    @@index([trainingProgramId])
    @@index([userId, isLocked])
}

// ---------------------------- New Models For Admin Dashboard ------------------------------------- //

model SessionBooking {
    id               String           @id @default(cuid())
    user             User             @relation("SessionBookingPlayer", fields: [userId], references: [id])
    userId           String
    activity         Activity         @relation(fields: [activityId], references: [id])
    activityId       String
    bookedAt         DateTime         @default(now())
    bookingStatus    BookingStatus    @default(BOOKED)
    attendanceStatus AttendanceStatus @default(NO_SHOW)
    createdAt        DateTime         @default(now())
    updatedAt        DateTime         @updatedAt

    @@index([userId])
    @@index([activityId])
    @@index([bookedAt])
    @@index([attendanceStatus])
    @@index([userId, bookedAt])
}

model ChurnEvent {
    id          String   @id @default(cuid())
    user        User     @relation(fields: [userId], references: [id])
    userId      String
    eventType   String
    eventDate   DateTime
    scoreImpact Int      @default(0)
    reasonText  String?  @db.Text
    metaJson    Json?
    createdAt   DateTime @default(now())

    @@index([userId])
    @@index([eventType])
    @@index([eventDate])
    @@index([userId, eventDate])
}

model PlayerHealthSummary {
    id                    String      @id @default(cuid())
    user                  User        @relation(fields: [userId], references: [id])
    userId                String      @unique
    joinedAt              DateTime
    lastTrainingAt        DateTime?
    lastLiveSessionAt     DateTime?
    lastFeedActivityAt    DateTime?
    trainingRiskPoints    Int         @default(0)
    liveSessionRiskPoints Int         @default(0)
    feedRiskPoints        Int         @default(0)
    totalRiskScore        Int         @default(0)
    currentStatus         ChurnStatus @default(HEALTHY)
    lastCalculatedAt      DateTime?
    createdAt             DateTime    @default(now())
    updatedAt             DateTime    @updatedAt

    @@index([userId])
    @@index([currentStatus])
    @@index([totalRiskScore])
    @@index([lastCalculatedAt])
}

model MonthlyChurnMetric {
    id                  String   @id @default(cuid())
    monthStartDate      DateTime
    club                Club?    @relation(fields: [clubId], references: [id])
    clubId              String?
    healthyCount        Int      @default(0)
    mightLeaveSoonCount Int      @default(0)
    atRiskCount         Int      @default(0)
    churnedCount        Int      @default(0)
    newPlayers          Int      @default(0)
    netGrowth           Int      @default(0)
    retentionRate       Decimal? @db.Decimal(5, 2)
    churnRate           Decimal? @db.Decimal(5, 2)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@index([monthStartDate])
    @@index([clubId, monthStartDate])
}
